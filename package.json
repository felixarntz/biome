{
  "name": "@felixarntz/biome",
  "version": "0.4.0",
  "description": "Reusable Biome (GritQL) lint rules that make your agent produce better code in fewer review cycles.",
  "keywords": [
    "biome",
    "biomejs",
    "gritql",
    "lint",
    "rules",
    "linter",
    "plugin"
  ],
  "homepage": "https://github.com/felixarntz/biome#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixarntz/biome.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./object-hasown": {
      "types": "./types/object-hasown/index.d.ts"
    }
  },
  "files": [
    "rules/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:groups && pnpm build:all",
    "build:all": "node scripts/generate-all.mjs",
    "build:groups": "node scripts/generate-groups.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm build && tsc --noEmit && node test/run.mjs",
    "test": "pnpm build && node test/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.1.1"
  },
  "packageManager": "pnpm@11.28.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
