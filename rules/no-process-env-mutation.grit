language js

or {
  JsAssignmentExpression(left = JsStaticMemberAssignment(object = `process.env`)) as $mutation,
  JsAssignmentExpression(left = JsComputedMemberAssignment(object = `process.env`)) as $mutation,
  `process.env = $value` as $mutation,
  `delete process.env.$key` as $mutation,
  `delete process.env[$key]` as $mutation,
  `Object.assign(process.env, $...)` as $mutation
} where {
  register_diagnostic(span=$mutation, message="Avoid mutating `process.env` directly. Read environment values into configuration and pass an explicit `env` object to child processes; process-global writes can leak across tests and concurrent code.")
}
