language js

TsPropertySignatureTypeMember(
  type_annotation = TsTypeAnnotation(ty = TsUnionType(types = $types))
) as $property where {
  $types <: or {
    [..., TsNullLiteralType(), ...],
    [..., TsUndefinedType(), ...]
  },
  register_diagnostic(span=$property, message="Do not include `null` or `undefined` in a property type to represent absence. Use optional property syntax and keep the property's value type non-nullish.")
}
